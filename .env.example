# Copy to .env in the project or your existing data directory. Restart to apply.
# This file contains examples only. Never commit your real .env.
TCG_MODEL_PROVIDER=openai
TCG_MODEL_BASE_URL=http://127.0.0.1:1234/v1
TCG_MODEL_NAME=your-model-id
TCG_API_KEY=""
TCG_MODEL_TIMEOUT_SECONDS=3600

# bearer: API Key plus optional custom headers
# headers: only the explicitly configured custom headers, no implicit Bearer
TCG_MODEL_AUTH_MODE=bearer
TCG_MODEL_HEADERS_JSON='{}'

# standard: existing SDK JSON mode and upstream streaming (default).
# minimal: POST only model/messages; content uses [{type:"text",text:"..."}].
# No temperature, response_format, stream, or stream_options is sent in minimal.
TCG_MODEL_REQUEST_MODE=standard

# Header-only gateway example (replace the settings above, not an extra section):
# TCG_MODEL_AUTH_MODE=headers
# TCG_MODEL_HEADERS_JSON='{"X-API-Key":"your-key","X-Tenant-ID":"your-tenant"}'
# For Authorization: Bearer your-key in custom headers, select headers mode.
# JSON must be on one line. Quote the entire JSON with single quotes.

# Limited Chat Completions gateway (replace the settings above):
# TCG_MODEL_PROVIDER=openai
# TCG_MODEL_BASE_URL=http://127.0.0.1:1234/api/v1
# TCG_MODEL_NAME=gpt-5
# TCG_API_KEY=""
# TCG_MODEL_AUTH_MODE=headers
# TCG_MODEL_HEADERS_JSON='{"X-API-Key":"your-key"}'
# TCG_MODEL_REQUEST_MODE=minimal
# A full .../api/v1/chat/completions URL is also accepted (never appended twice).
# Content-Type: application/json is automatic; adding that exact header is OK.
# Frontend SSE still carries progress; minimal mode delivers text after upstream
# JSON completes instead of inventing token-by-token output.

# Ollama example: provider=ollama, base_url=http://127.0.0.1:11434,
# model=the exact model name from ollama list. No key needed for local Ollama.
