# Copy this file to <your data directory>/.env and fill in your own API key.
# The endpoint is for SiliconFlow China; use your provider's URL if different.
TCG_MODEL_PROVIDER=openai
TCG_MODEL_BASE_URL=https://api.siliconflow.cn/v1
TCG_MODEL_NAME=meituan-longcat/LongCat-2.0
TCG_API_KEY=''
# All model timeouts are fixed at 60 minutes in this build.
# Legacy shorter values are accepted and normalized to 3600 at startup.
TCG_MODEL_TIMEOUT_SECONDS=3600

# Ollama alternative: change provider/base URL/model and leave API key empty.
# TCG_MODEL_PROVIDER=ollama
# TCG_MODEL_BASE_URL=http://127.0.0.1:11434
# TCG_MODEL_NAME=your-installed-model

# Single-line NAME=value syntax. Quote values containing spaces or #.
# Python reads literal values: no shell commands or ${VARIABLE} expansion.
# Docker Compose uses its own parser; single-quote keys containing $.
# Restart the service after editing. The UI will show the active settings.
